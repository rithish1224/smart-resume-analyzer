# ─── Application ─────────────────────────────────────────────────────────────
APP_NAME="Smart Competency Diagnostic"
APP_VERSION="1.0.0"
DEBUG=true
SECRET_KEY="your-super-secret-jwt-key-change-this-in-production-min-32-chars"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# ─── Database ─────────────────────────────────────────────────────────────────
DATABASE_URL="sqlite+aiosqlite:///./competency_diagnostic.db"

# ─── CORS ─────────────────────────────────────────────────────────────────────
FRONTEND_URL="http://localhost:5173"
ALLOWED_ORIGINS="http://localhost:5173,http://localhost:3000"

# ─── AI Providers ─────────────────────────────────────────────────────────────
# OpenRouter (Primary Provider)
OPENROUTER_API_KEY="sk-or-v1-your-openrouter-api-key-here"
OPENROUTER_BASE_URL="https://openrouter.ai/api/v1"
OPENROUTER_MODEL="mistralai/mistral-7b-instruct:free"
OPENROUTER_FREE_LIMIT=200

# Google AI Studio / Gemini (Fallback Provider)
GOOGLE_AI_API_KEY="your-google-ai-studio-api-key-here"
GOOGLE_AI_MODEL="gemini-1.5-flash"

# AI Router Config
ENABLE_FALLBACK=true
AI_TIMEOUT_SECONDS=30
AI_MAX_RETRIES=2

# ─── File Upload ──────────────────────────────────────────────────────────────
UPLOAD_DIR="./uploads"
MAX_FILE_SIZE_MB=1
ALLOWED_EXTENSIONS="pdf,docx,txt,jpg,jpeg,png"

# ─── ML Model ─────────────────────────────────────────────────────────────────
MODEL_PATH="./backend/models/trained/xgb_ranker.json"
MODEL_VERSION="v1.0.0"
HYBRID_ALPHA=0.65

# ─── OCR ──────────────────────────────────────────────────────────────────────
# On Windows: install Tesseract and set path
TESSERACT_CMD="C:/Program Files/Tesseract-OCR/tesseract.exe"
OCR_CONFIDENCE_THRESHOLD=60

# ─── Scoring Thresholds ───────────────────────────────────────────────────────
SHORTLIST_THRESHOLD=75
REVIEW_THRESHOLD=50

# ─── Fairness ─────────────────────────────────────────────────────────────────
FAIRNESS_DIR_THRESHOLD=0.80
FAIRNESS_DP_THRESHOLD=0.10
FAIRNESS_EO_THRESHOLD=0.10
